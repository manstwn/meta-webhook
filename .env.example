# Server Configuration
PORT=2958
NODE_ENV=production
# Set to false to disable writing server logs to file/disk
LOG=false
LOG_LEVEL=info

# Admin Security
ADMIN_PIN=123456

# Outbound Gateway API Key (Header: x-api-key or Authorization: Bearer <key>)
API_KEY=your_secret_gateway_api_key_here

# Meta WhatsApp Cloud API Credentials
# Webhook handshake verification token registered in Meta App Dashboard
VERIFY_TOKEN=your_meta_verify_token_here

# Permanent System User Access Token with whatsapp_business_messaging permission
WHATSAPP_TOKEN=your_meta_system_user_access_token_here

# Meta WhatsApp Phone Number ID (From API Setup page)
PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here

# Optional: Meta App Secret for HMAC-SHA256 signature verification (X-Hub-Signature-256)
APP_SECRET=your_meta_app_secret_here

# Optional: Static external URL to forward incoming webhooks in real-time
FORWARD_URL=https://your-domain.com/api/incoming-whatsapp-webhook
